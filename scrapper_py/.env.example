# Paths are relative to the directory where you run the command.
SCRAPER_DATABASE_URL=sqlite:///data/automobiles.db
SCRAPER_DATA_DIR=data
SCRAPER_BASE_URL=https://www.autoevolution.com
# Browser is the default, matching the original Chromium scraper.
SCRAPER_TRANSPORT=browser
SCRAPER_CONCURRENCY=2
SCRAPER_REQUEST_INTERVAL=1.5
SCRAPER_TIMEOUT=45
SCRAPER_ATTEMPTS=3
SCRAPER_HEADLESS=true
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_USER_AGENT=AutomobileSpecsScraper/1.0
